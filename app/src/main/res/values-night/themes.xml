<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.MoonWidget" parent="Theme.MaterialComponents.DayNight.NoActionBar.Bridge">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/widget_primary</item>
        <item name="colorPrimaryVariant">@color/widget_secondary</item>
        <item name="colorOnPrimary">@color/widget_on_primary</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/widget_tertiary</item>
        <item name="colorSecondaryVariant">@color/widget_tertiary</item>
        <item name="colorOnSecondary">@color/widget_on_primary</item>
        <!-- Status bar. -->
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <!-- Customize your theme here. -->
    </style>
</resources>